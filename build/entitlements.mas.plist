<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build. Mochi needs no network, files or devices, so the
     sandbox has nothing switched on beyond what Electron itself requires.
     TEAM_ID is replaced with the Apple Developer team ID at build time. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>TEAM_ID.com.mochi.desktoppet</string>
  </array>
</dict>
</plist>

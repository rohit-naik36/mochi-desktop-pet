{
  "name": "mochi-desktop-pet",
  "version": "0.6.0",
  "description": "A tiny desktop pet that keeps you company and reminds you to drink water and stretch.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:store": "electron-builder --win appx --publish never"
  },
  "author": "Rohit",
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "productName": "Mochi",
  "build": {
    "appId": "com.mochi.desktoppet",
    "productName": "Mochi",
    "files": [
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Mochi"
    },
    "portable": {
      "artifactName": "Mochi-Portable-${version}.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "appx": {
      "displayName": "Mochi",
      "applicationId": "Mochi",
      "backgroundColor": "transparent",
      "showNameOnTiles": false
    }
  }
}

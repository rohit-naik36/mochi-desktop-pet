{
  "name": "mochi-desktop-pet",
  "version": "0.12.0",
  "description": "A tiny desktop pet that keeps you company and reminds you to drink water and stretch.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:store": "electron-builder --win appx --publish never",
    "dist:mas": "electron-builder --mac mas:universal --publish never"
  },
  "author": "Rohit Naik",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Mochi",
  "build": {
    "copyright": "Copyright © 2026 Unorthologic LLP",
    "appId": "com.mochi.desktoppet",
    "productName": "Mochi",
    "files": [
      "src/**/*",
      "!node_modules/@node-llama-cpp/*cuda*/**",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Mochi"
    },
    "portable": {
      "artifactName": "Mochi-Portable-${version}.exe"
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Mochi-${version}-mac.${ext}",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true
      },
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/**"
    },
    "mas": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "hardenedRuntime": false,
      "artifactName": "Mochi-AppStore-${version}.${ext}"
    },
    "dmg": {
      "title": "Mochi"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "appx": {
      "identityName": "LittleSmokeStudio.Mochi-DeskBuddy",
      "publisher": "CN=ADA1E3C2-3E06-4042-A35B-43FD71C1740A",
      "publisherDisplayName": "Little Smoke Studio",
      "displayName": "Mochi - Desk Buddy",
      "applicationId": "Mochi",
      "backgroundColor": "#E2EDFA",
      "showNameOnTiles": false,
      "languages": [
        "en-US"
      ],
      "artifactName": "Mochi-Store-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ]
  },
  "dependencies": {
    "node-llama-cpp": "3.22.2"
  }
}
